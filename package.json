{
  "name": "n8n-nodes-companies-house",
  "version": "0.1.20",
  "description": "n8n community node for Companies House UK",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "",
  "author": {
    "name": "Ian Carroll",
    "email": "ian@solutioneers.co.uk"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webstudi0/n8n-nodes-companies-house.git"
  },
  "engines": {
    "node": ">=18.10",
    "pnpm": ">=9.1"
  },
  "packageManager": "pnpm@9.1.4",
  "main": "index.js",
  "scripts": {
    "build": "npx tsc && npx gulp build:icons",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "gulp": "^4.0.2",
    "n8n-workflow": "*",
    "typescript": "^5.5.3"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/CompaniesHouseApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/CompaniesHouse/CompaniesHouse.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "volta": {
    "node": "18.18.0"
  }
}
